# 1. Paste your free Gemini API key between the quotes (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=""

# 2. Which Gemini model to use (free tier). You can leave this as it is.
GEMINI_MODEL="gemini-3.8-flash"

# Optional: where your planner data is saved. Leave empty to use data/planner.db in this folder.
DATABASE_PATH=""

# Optional: only needed when you put the site online. If set, the site asks for this password.
PLANNER_PASSWORD=""
